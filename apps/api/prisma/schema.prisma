// Esquema de VM-Finance.
// Los modelos (User, UserSettings, MonthlyBudget, Transaction, PaymentReminder, ...)
// se agregan en la Fase 1 del plan de acción (docs/PLAN-MVP.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}
