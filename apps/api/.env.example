# --- Servidor ---
PORT=3000
NODE_ENV=development
TZ=America/Bogota
# Origen permitido por CORS (URL del frontend)
FRONTEND_URL=http://localhost:4200

# --- Base de datos ---
# Local (docker compose):
DATABASE_URL=postgresql://vmfinance:vmfinance@localhost:5432/vmfinance
DIRECT_URL=postgresql://vmfinance:vmfinance@localhost:5432/vmfinance
# Neon (producción): DATABASE_URL con host -pooler, DIRECT_URL sin -pooler
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/vmfinance?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/vmfinance?sslmode=require

